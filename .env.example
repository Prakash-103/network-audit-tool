# ==============================================================================
# Enterprise Network Infrastructure Audit Platform - Environment Configuration
# Copy this file to '.env' and customize for your local deployment.
# NEVER commit your actual '.env' or credentials to version control.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Application Metadata
COMPANY_NAME=Enterprise Org
DEFAULT_SITE=HQ Data Center
APP_SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Audit Session & Concurrency Limits
MAX_CONCURRENT_SSH_WORKERS=5
DEFAULT_SSH_TIMEOUT_SECONDS=30
EXECUTION_POLL_INTERVAL_MS=500

# Zero-Storage Credential Security
# Device credentials are held STRICTLY in ephemeral RAM during Stage 3 CLI trigger sessions
# and erased immediately upon job completion. Never persist credentials to environment variables.
DEVICE_DEFAULT_USERNAME=audit_readonly
DEVICE_SSH_PORT=22

# Export & Evidence Settings
EXCEL_OUTPUT_DIRECTORY=./
AUDIT_LOGS_DIRECTORY=./collected_logs
RETAIN_COLLECTED_LOGS_DAYS=14
